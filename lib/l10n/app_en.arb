  "aboutMriWhatTitle": "What is MRI?",
  "@aboutMriWhatTitle": { "description": "About MRI: first section title." },
  "aboutMriWhatBody": "MRI (Mood Ring Index) is a single 0–100 score that estimates how the weather actually feels. Higher values mean cooler (blue), around 64 is comfortable (green), and lower values mean hotter and less comfortable (red).",
  "@aboutMriWhatBody": { "description": "About MRI: plain-language summary of mri-spec §1/§3." },
  "aboutMriBandsTitle": "Bands",
  "@aboutMriBandsTitle": { "description": "About MRI: section title for the 5 band rows (mri-spec §4)." },
  "aboutMriReadingLabel": "READING THE SCORE",
  "@aboutMriReadingLabel": { "description": "Mono label of the 'reading the score' panel on About MRI (Figma 6:73)." },
  "aboutMriReadingBody": "Comfortable sits in the middle of the scale.",
  "@aboutMriReadingBody": { "description": "Body of the 'reading the score' panel on About MRI (Figma 6:75)." },
  "aboutMriOptimalNote": "When it matches your comfort sweet spot, we show “Optimal”.",
  "@aboutMriOptimalNote": { "description": "Note under the Comfortable band row; Optimal is a personal state, not a band (unified fixes doc 7.1)." },
  "aboutMriColdNote": "When the feels-like temperature is below {cold}, we show “Cold”; at {veryCold} or below, “Very cold — bundle up”. This is the app’s own guide, not an official alert. The color doesn’t change.",
  "@aboutMriColdNote": { "description": "Note under the Cool band row (80–100). MRI levels off in the cold, so the label follows the apparent temperature: Cold below {cold} (Cool band only), Very cold — bundle up at {veryCold} or below (any band). {cold}/{veryCold} are temperatures already formatted in the user's unit, e.g. \"6°\" / \"-10°\" or \"43°\" / \"14°\". Use the band labels in sentence case here.", "placeholders": { "cold": { "type": "String" }, "veryCold": { "type": "String" } } },
  "aboutMriWbgtNote": "Heat risk is judged separately from MRI, using the heat index (WBGT): Caution / Warning / Severe warning / Danger.",
  "@aboutMriWbgtNote": { "description": "Note under the band table; heat risk uses WBGT, not MRI (unified fixes doc 7.1)." },
  "aboutMriFactorsTitle": "What goes into MRI",
  "@aboutMriFactorsTitle": { "description": "About MRI: section title for the 6 factors shown (mri-spec §2). Pollen is not shown until pollen data is connected (compliance-review-v1.3.0 §8)." },
  "aboutMriFactorsBody": "Temperature, humidity, UV, air quality, wind and pressure changes are each scored and combined with weights into one number.",
  "@aboutMriFactorsBody": { "description": "About MRI: how the 6 sub-scores are combined. Do not mention pollen until pollen data is connected (compliance-review-v1.3.0 §8-4)." },
  "aboutMriCalibrationTitle": "Personal calibration",
  "@aboutMriCalibrationTitle": { "description": "About MRI: calibration section title (mri-spec §6)." },
  "aboutMriCalibrationBody": "When you record how the weather feels, MRI gradually adapts to your own sensitivity. All learning data stays on this device and can be reset anytime.",
  "@aboutMriCalibrationBody": { "description": "About MRI: calibration in plain language, with on-device note (spec §9.4)." },
  "aboutMriDisclaimerTitle": "Disclaimer",
  "@aboutMriDisclaimerTitle": { "description": "About MRI: disclaimer section title (mri-spec §0/§5.4)." },
  "aboutMriDisclaimerBody": "MRI is an independent estimate by Mood-Ring Weather, provided for reference only. It is not medical advice, a diagnosis, or an official government warning. For safety decisions, refer to official sources.",
  "@aboutMriDisclaimerBody": { "description": "About MRI: independent estimate / not medical / not official (compliance)." },

